      { "type": "item", "label": "Plane",    "action": "CreatePlane" },
      { "type": "item", "label": "Box",      "action": "CreateBox" },
      { "type": "item", "label": "Sphere",   "action": "CreateSphere" },
      { "type": "item", "label": "Cylinder", "action": "CreateCylinder" },
      { "type": "item", "label": "Cone",     "action": "CreateCone" },
      { "type": "item", "label": "Torus",    "action": "CreateTorus" },
      { "type": "item", "label": "Disk",     "action": "CreateDisk" },
      { "type": "item", "label": "Capsule",  "action": "CreateCapsule" },
      { "type": "item", "label": "Arrow",    "action": "CreateArrow" }
    ]},
