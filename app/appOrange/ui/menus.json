{
  "type": "menubar",
  "children": [
    { "type": "menu", "label": "File", "children": [
      { "type": "item", "label": "Open...",    "action": "OpenFile",   "shortcut": "Ctrl+O" },
      { "type": "item", "label": "Save",       "action": "SaveFile",   "shortcut": "Ctrl+S" },
      { "type": "item", "label": "Save As...", "action": "SaveFileAs", "shortcut": "Ctrl+Shift+S" },
      { "type": "separator" },
      { "type": "item", "label": "Screenshot", "action": "Screenshot", "shortcut": "C" },
      { "type": "separator" },
      { "type": "item", "label": "Quit",       "action": "Quit",       "shortcut": "Esc" }
    ]},
    { "type": "menu", "label": "Edit", "children": [
