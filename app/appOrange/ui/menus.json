      { "type": "check", "label": "Off",          "action": "SpatialNone" },
      { "type": "check", "label": "BVH",          "action": "SpatialBVH" },
      { "type": "check", "label": "Octree",       "action": "SpatialOctree" },
      { "type": "check", "label": "KD-Tree",      "action": "SpatialKDTree" },
      { "type": "check", "label": "Uniform Grid", "action": "SpatialGrid" },
      { "type": "check", "label": "Loose Octree", "action": "SpatialLoose" },
      { "type": "check", "label": "BSP",          "action": "SpatialBSP" },
      { "type": "check", "label": "R-Tree",       "action": "SpatialRTree" },
      { "type": "check", "label": "Ball Tree",    "action": "SpatialBall" }
    ]}
